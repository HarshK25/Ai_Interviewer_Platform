# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="AI Interviewer Platform"
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_interviewer
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_interviewer

# ─── Vector Store ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Options: gemini | openai
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_MODEL=gemini-1.5-pro
OPENAI_MODEL=gpt-4o

# ─── Voice ───────────────────────────────────────────────────────────────────
# Options: tiny | base | small | medium | large
WHISPER_MODEL_SIZE=base
# Optional — leave blank to use free gTTS
ELEVENLABS_API_KEY=

# ─── File Storage (MinIO local / AWS S3 production) ──────────────────────────
S3_BUCKET=ai-interviewer
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1

# ─── Redis + Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Email ───────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@ai-interviewer.com

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
